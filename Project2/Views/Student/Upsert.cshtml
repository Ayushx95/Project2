@model Project2.Models.Student

@{
    var Title = Model.Id != 0 ? "Edit Student" : "New Student";
    var SaveOrUpdate = Model.Id != 0 ? "Update" : "Save";
}

<h2 class="text-primary text-center">@Title</h2>

<form method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="row border p-2 m-2">

        <div class="form-group row p-2 m-2">
            <label asp-for="Name" class="col-form-label"></label>
        </div>
        <div class="col-8">
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

            <div class="form-group row p-2 m-3">
                <div class="col-4">
                    <button type="submit" class="btn btn-info form-control">
                        @SaveOrUpdate
                    </button>
                </div>
            </div>

    </div>

</form>