@model Project2.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Confirm Delete</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this student?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Address
                </dt>

                <dd class="col-sm-9">
                    @Model.Address
                </dd>

                <dt class="col-sm-3">
                    Age
                </dt>

                <dd class="col-sm-9">
                    @Model.Age
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>

            </dl>

            <hr />
            <form asp-controller="Student"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="confirm" value="true" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>