@model IEnumerable<Project2.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<p>
    <a asp-action="Upsert" class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Age</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var Student in Model)
        {
            <tr>
                <td>@Student.Name</td>
                <td>@Student.Address</td>
                <td>@Student.Age</td>
                <td>@Student.Email</td>

                <td>
                    <a asp-action="Upsert"
                       asp-route-id="@Student.Id"
                       class="btn btn-info btn-sm">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@Student.Id"
                       class="btn btn-success btn-sm">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Student.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>